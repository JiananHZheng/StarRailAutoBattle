<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StarRailAutoBattle"
        Width="720" Height="880" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,24,28,16" MaxWidth="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="STAR RAIL AUTO BATTLE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="StarRailAutoBattle" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,4" />
            <TextBlock Text="“视频”页录制并识别 B 站视频里的行动轴；“游戏”页启动或识别游戏。点击各页的“启动”之前，不会打开或启动任何东西。"
                       Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="Pages">

            <!-- ==================== Video ==================== -->
            <TabItem Header="视频" AutomationProperties.Name="视频页">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="B 站视频链接" />
                                <TextBox x:Name="VideoLinkBox" TextChanged="VideoLinkBox_TextChanged" AutomationProperties.Name="B 站视频链接" />
                                <TextBlock x:Name="VideoLinkError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="可直接粘贴 B 站的分享文字或链接（www.bilibili.com/video/BV… 或 b23.tv 短链接）。点击“启动”后，程序在后台播放（不显示窗口、不抢前台），自动关闭弹幕、选择可用的最高清晰度，按每秒 15 帧录下所选时间段后再识别。截图跟不上时会放慢播放，因此录制用时可能比片段本身长。" />
                                <Border Margin="0,12,0,0" Padding="12,10" Background="{StaticResource InfoBackBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BiliAccountText" Text="B 站登录：正在检查…" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="BiliLoginButton" Content="登录 B 站…" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButton}" Click="BiliLoginButton_Click" />
                                            <Button Grid.Column="2" x:Name="BiliLogoutButton" Content="退出登录" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButton}" Click="BiliLogoutButton_Click" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HelpText}"
                                                   Text="B 站不登录时只能播放 360P，登录后可录 1080P（1080P 60 帧需要大会员）。登录只需一次，在本程序自己的浏览器里进行，账号和密码由 B 站页面处理，本程序不读取、不保存；不会使用 Edge 浏览器里已有的登录。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="时间段（可选）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起点" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                                    <TextBox Grid.Column="1" x:Name="VideoStartBox" TextChanged="VideoTimeBox_TextChanged" AutomationProperties.Name="起点" />
                                    <TextBlock Grid.Column="2" Text="终点" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="13" />
                                    <TextBox Grid.Column="3" x:Name="VideoEndBox" TextChanged="VideoTimeBox_TextChanged" AutomationProperties.Name="终点" />
                                </Grid>
                                <TextBlock x:Name="VideoTimeError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="写成 1:14 或 74（秒）。都不填则处理整段视频；只填起点则处理到视频结尾；只填终点则从开头开始。对链接和自录文件都有效。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="自录视频文件（可选）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VideoFileBox" TextChanged="VideoFileBox_TextChanged" AutomationProperties.Name="自录视频文件路径" />
                                    <Button Grid.Column="1" x:Name="BrowseVideoFileButton" Content="浏览文件…" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="BrowseVideoFileButton_Click" />
                                    <Button Grid.Column="2" x:Name="ClearVideoFileButton" Content="清除" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="ClearVideoFileButton_Click" />
                                </Grid>
                                <TextBlock x:Name="VideoFileError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="链接无法录制时（例如要求登录、出现人机验证、画面黑屏或找不到播放器），可以选择你自己录好的视频文件。选择了文件时直接识别文件，不再打开链接。支持 mp4、mkv、mov、avi、webm、flv。" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,4,0,14">
                            <Button x:Name="VideoStartButton" Content="启动" Style="{StaticResource PrimaryButton}" Click="VideoStartButton_Click" Margin="0,0,10,0" />
                            <Button x:Name="VideoCancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                                    Click="VideoCancelButton_Click" Visibility="Collapsed" Margin="0,0,10,0" />
                            <Button x:Name="EditResultButton" Content="编辑结果" Style="{StaticResource SecondaryButton}"
                                    Click="EditResultButton_Click" IsEnabled="False" Margin="0,0,10,0"
                                    ToolTip="用记事本等文本编辑器打开识别结果的可编辑副本（result_edit.txt）。工具生成的原始结果保持只读，不会被改动。" />
                            <Button x:Name="OpenRunFolderButton" Content="打开结果文件夹" Style="{StaticResource SecondaryButton}"
                                    Click="OpenRunFolderButton_Click" Visibility="Collapsed" />
                        </WrapPanel>

                        <Border x:Name="VideoStatusBorder" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="VideoStatusDot" Width="10" Height="10" Fill="#9AA5B5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="VideoStatusTitle" Text="准备就绪" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <ProgressBar x:Name="VideoProgress" Margin="18,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                <TextBlock x:Name="VideoStatusText" FontSize="13" Margin="18,8,0,0"
                                           Text="点击“启动”后，这里会显示录制和识别的进度。识别结果保存为文本文件，可用“编辑结果”打开。" />
                                <TextBlock x:Name="VideoStatusNote" FontSize="12" Margin="18,6,0,0" Foreground="#8A5A00" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Game ==================== -->
            <TabItem Header="游戏" AutomationProperties.Name="游戏页">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="游戏入口（.exe 或 .lnk 快捷方式）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EntryBox" TextChanged="EntryBox_TextChanged"
                                             AutomationProperties.Name="游戏入口路径" />
                                    <Button Grid.Column="1" x:Name="BrowseEntryButton" Content="浏览文件…" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="BrowseEntryButton_Click" />
                                </Grid>
                                <TextBlock x:Name="EntryError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <Border x:Name="EntryInfoPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,10"
                                        Background="{StaticResource InfoBackBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock x:Name="EntryTypeText" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="EntryDetailsText" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="EntryWarningText" FontSize="12" Margin="0,6,0,0" Foreground="#8A5A00" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="可选择游戏或官方启动器的真实 .exe，也可选择它们的快捷方式。快捷方式的目标、参数和“起始位置”按快捷方式本身的设置由 Windows 处理。资源管理器可能隐藏 .lnk 扩展名，请以上方显示的“实际类型”为准。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="运行模式" Margin="0,0,0,10" />
                                <RadioButton x:Name="ModeStart" GroupName="Mode" IsChecked="True">
                                    <StackPanel Margin="6,-2,0,0">
                                        <TextBlock Text="启动游戏" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                                   Text="像在资源管理器中双击一样打开所选入口。若程序要求管理员权限，Windows 会弹出确认框，由你决定。之后会等待游戏窗口出现并尝试切到前台。" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeIdentify" GroupName="Mode" Margin="0">
                                    <StackPanel Margin="6,-2,0,0">
                                        <TextBlock Text="只识别已运行游戏" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                                   Text="不启动任何程序。查找你已通过官方启动器打开的游戏窗口，尝试还原并切到前台。适合游戏必须由官方启动器启动的情况。" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="识别窗口用的游戏程序（可选）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GameExeBox" TextChanged="GameExeBox_TextChanged"
                                             AutomationProperties.Name="识别窗口用的游戏程序路径" />
                                    <Button Grid.Column="1" x:Name="BrowseGameButton" Content="浏览文件…" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="BrowseGameButton_Click" />
                                </Grid>
                                <TextBlock x:Name="GameExeError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="如果上方入口是官方启动器，请在这里选择游戏本体的 .exe（例如游戏安装目录里的主程序），用来识别游戏窗口。留空时使用入口实际指向的程序。" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,4,0,14">
                            <Button x:Name="LaunchButton" Content="启动" Style="{StaticResource PrimaryButton}" Click="LaunchButton_Click" Margin="0,0,10,0" />
                            <Button x:Name="ActivateButton" Content="切换到游戏窗口" Style="{StaticResource SecondaryButton}"
                                    Click="ActivateButton_Click" Visibility="Collapsed" Margin="0,0,10,0" />
                            <Button x:Name="CancelWaitButton" Content="停止等待窗口" Style="{StaticResource SecondaryButton}"
                                    Click="CancelWaitButton_Click" Visibility="Collapsed" />
                        </WrapPanel>

                        <Border x:Name="StatusBorder" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#9AA5B5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StatusTitle" Text="准备就绪" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <TextBlock x:Name="StatusGame" FontSize="13" Margin="18,8,0,0"
                                           Text="点击“启动”后，这里会显示游戏的处理结果。" />
                                <Expander x:Name="DiagnosticsExpander" Header="诊断详情（只含文件名和错误码，不含完整路径）" Margin="0,12,0,0"
                                          FontSize="12" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"
                                                 FontSize="12" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                                        <Button Content="打开日志文件夹" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Style="{StaticResource SecondaryButton}" Click="OpenLogFolder_Click" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                   Text="识别在本机运行，不调用大模型 · 不上传任何本机路径 · 不会自动以管理员身份运行" />
    </Grid>
</Window>
